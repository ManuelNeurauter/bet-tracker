# BetLedger Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bet_tracker_db

# Application Settings
APP_ENV=development
APP_NAME=BetLedger
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Session Configuration
SESSION_LIFETIME=2592000

# Database Charset
DB_CHARSET=utf8mb4

# Email Configuration (optional, for future notifications)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@betledger.local

# Feature Flags
FEATURE_NOTIFICATIONS=true
FEATURE_EXPORT=true
FEATURE_IMPORT=true
FEATURE_CHARTS=true

# Default Currency
DEFAULT_CURRENCY=USD

# Pagination
ITEMS_PER_PAGE=20

# Logging
LOG_LEVEL=info
LOG_PATH=logs/
